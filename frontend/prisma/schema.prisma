generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// ENUMS
// ----------------------------------------------------------------------------

enum IdentitySource {
  test
  real
}

enum RetentionPeriod {
  one_week
  two_weeks
  one_month
  three_months
  six_months
}

enum BatchStatus {
  draft
  processing
  ready_for_review
  approved
  exported
}

enum AnswerSheetStatus {
  processing
  needs_review
  auto_approved
  manual
  failed
  reviewed
}

enum QuestionMarkSource {
  auto
  corrected
}

enum PdfUploadStatus {
  processing
  split
  failed
}

// ----------------------------------------------------------------------------
// MODELS
// ----------------------------------------------------------------------------

model Professor {
  id              String         @id @default(uuid()) @db.Uuid
  identity_source IdentitySource @default(test)
  external_id     String
  password_hash   String?  // Used only when identity_source is 'test'
  name            String
  college_code    String
  department      String
  created_at      DateTime       @default(now())

  // Relations
  batches    Batch[]
  audit_logs AuditLogEntry[]
  sessions   Session[]

  @@map("professors")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  professor_id String   @db.Uuid
  expires_at   DateTime
  created_at   DateTime @default(now())

  professor    Professor @relation(fields: [professor_id], references: [id], onDelete: Cascade)

  @@index([professor_id])
  @@map("sessions")
}

model Batch {
  id                    String          @id @default(uuid()) @db.Uuid
  professor_id          String          @db.Uuid
  declared_subject_code String
  declared_subject_name String
  declared_course_batch String
  retention_period      RetentionPeriod
  images_purge_at       DateTime?
  status                BatchStatus     @default(draft)
  created_at            DateTime        @default(now())
  approved_at           DateTime?

  // Relations
  professor     Professor     @relation(fields: [professor_id], references: [id])
  answer_sheets AnswerSheet[]
  pdf_uploads   PdfUpload[]

  @@index([professor_id])
  @@map("batches")
}

model PdfUpload {
  id                String          @id @default(uuid()) @db.Uuid
  batch_id          String          @db.Uuid
  original_filename String
  storage_key       String?         // S3/MinIO key where the PDF is stored
  status            PdfUploadStatus @default(processing)
  error_message     String?
  created_at        DateTime        @default(now())

  // Relations
  batch Batch @relation(fields: [batch_id], references: [id])

  @@index([batch_id])
  @@map("pdf_uploads")
}

model AnswerSheet {
  id                String            @id @default(uuid()) @db.Uuid
  batch_id          String            @db.Uuid
  image_storage_key String            @unique // Idempotency key
  original_filename String?           // Source filename from upload
  register_number   String?
  total_marks       Decimal?          @db.Decimal(5, 2)
  status            AnswerSheetStatus @default(processing)
  created_at        DateTime          @default(now())
  updated_at        DateTime          @updatedAt

  // Relations
  batch          Batch           @relation(fields: [batch_id], references: [id])
  question_marks QuestionMark[]
  audit_logs     AuditLogEntry[]

  @@index([batch_id])
  @@index([register_number])
  @@map("answer_sheets")
}

model QuestionMark {
  id               String             @id @default(uuid()) @db.Uuid
  answer_sheet_id  String             @db.Uuid
  question_no      String
  sub_part         String?
  marks            Decimal            @db.Decimal(5, 2)
  tick_state       Boolean
  confidence_score Decimal            @db.Decimal(5, 4)
  source           QuestionMarkSource @default(auto)

  // Relations
  answer_sheet AnswerSheet @relation(fields: [answer_sheet_id], references: [id])

  // Idempotency: allows ON CONFLICT upsert on retried jobs
  @@unique([answer_sheet_id, question_no, sub_part])
  @@map("question_marks")
}

model AuditLogEntry {
  id              String   @id @default(uuid()) @db.Uuid
  answer_sheet_id String   @db.Uuid
  professor_id    String   @db.Uuid
  field_changed   String
  old_value       String
  new_value       String
  created_at      DateTime @default(now())

  // Relations
  answer_sheet AnswerSheet @relation(fields: [answer_sheet_id], references: [id])
  professor    Professor   @relation(fields: [professor_id], references: [id])

  @@map("audit_log_entries")
}
