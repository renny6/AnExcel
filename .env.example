# =============================================================================
# AnExcel — Environment Variables
# Copy to .env and fill in real values. Never commit .env itself.
# =============================================================================

# --- Postgres -----------------------------------------------------------------
POSTGRES_USER=anexcel
POSTGRES_PASSWORD=
POSTGRES_DB=anexcel

# Connection string directly to Postgres
DATABASE_URL=postgresql://anexcel:${POSTGRES_PASSWORD}@postgres:5432/anexcel

# --- Redis --------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Object Storage (MinIO local) --------------------------------------------
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=anexcel_dev_key
S3_SECRET_KEY=anexcel_dev_secret
S3_BUCKET=anexcel-uploads

# --- Vision API (Google Gemini Flash, free tier) ------------------------------
VISION_API_KEY=

# --- Auth / Sessions ----------------------------------------------------------
SESSION_SECRET=

# --- Environment --------------------------------------------------------------
NODE_ENV=development
ENVIRONMENT=dev
